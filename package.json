{
  "name": "elysia-ddd",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --compile --minify --sourcemap --outfile dist/server",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "fmt": "biome check --write",
    "check": "tsc --noEmit && biome check && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@elysiajs/openapi": "^1.4.16",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
